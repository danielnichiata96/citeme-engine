{
  "name": "citeme-engine-wasm",
  "author": "danielnichiata",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/danielnichiata96/citeme-engine.git"
  },
  "version": "0.4.0",
  "description": "Bibliography interchange and CSL formatting for the browser — reads BibTeX, RIS, MEDLINE and CSL-JSON, writes BibTeX, BibLaTeX and RIS. Rust/Wasm, powered by Hayagriva.",
  "homepage": "https://github.com/danielnichiata96/citeme-engine#readme",
  "bugs": {
    "url": "https://github.com/danielnichiata96/citeme-engine/issues"
  },
  "type": "module",
  "main": "index.js",
  "types": "index.d.ts",
  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "files": [
    "README.md",
    "index.js",
    "index.d.ts",
    "pkg/citeme_engine_wasm.js",
    "pkg/citeme_engine_wasm.d.ts",
    "pkg/citeme_engine_wasm_bg.wasm",
    "pkg/citeme_engine_wasm_bg.wasm.d.ts"
  ],
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js",
      "default": "./index.js"
    },
    "./package.json": "./package.json",
    "./pkg/citeme_engine_wasm_bg.wasm": "./pkg/citeme_engine_wasm_bg.wasm"
  },
  "keywords": [
    "citation",
    "csl",
    "csl-json",
    "citeproc",
    "bibtex",
    "biblatex",
    "ris",
    "medline",
    "nbib",
    "pubmed",
    "bibliography",
    "reference-manager",
    "abnt",
    "hayagriva",
    "wasm",
    "rust",
    "academic"
  ],
  "license": "MIT"
}
